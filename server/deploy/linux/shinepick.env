# 拾光 API 环境配置（systemd EnvironmentFile）
# 修改后: systemctl restart shinepick-api

APP_ENV=prod
PORT=8080

# 数据库（本机 MySQL）
DB_DSN=root:CHANGE_ME@tcp(127.0.0.1:3306)/shinepick?charset=utf8mb4&parseTime=True&loc=Local

# Redis（本机）
REDIS_ADDR=127.0.0.1:6379

# JWT 密钥（生产必改：openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# 上传与对外地址（改为服务器公网域名/IP）
UPLOAD_DIR=/opt/shinepick/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 运营接口令牌（生产必改）
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# 短信/审核通道（接入后改为 aliyun / remote）
SMS_TYPE=mock
AUDIT_TYPE=mock
