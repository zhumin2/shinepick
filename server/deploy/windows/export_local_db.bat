@echo off
setlocal
chcp 65001 >nul
title ShinePick - export dev database

rem ====== dev mysql config ======
set "MYSQL_HOST=127.0.0.1"
set "MYSQL_PORT=3306"
set "MYSQL_ROOT_PASSWORD=123456"
set "DB_NAME=shinepick"
set "MYSQL_BIN=D:\Apps\mysql\mysql-8.0.28-winx64\bin"

rem ====== optional: ssh push ======
rem usage: export_local_db.bat [user@server-ip]
set "SSH_TARGET=%~1"

set "OUT=%~dp0shinepick-data.sql"

echo [1/2] Exporting dev data (data-only, REPLACE semantics)...
"%MYSQL_BIN%\mysqldump.exe" --no-create-info --replace --single-transaction --complete-insert --default-character-set=utf8mb4 --skip-triggers -h %MYSQL_HOST% -P %MYSQL_PORT% --protocol=tcp -u root -p%MYSQL_ROOT_PASSWORD% %DB_NAME% > "%OUT%"
if errorlevel 1 (
  echo Export FAILED: check local MySQL is running.
  pause
  exit /b 1
)

echo [2/2] Generating AUTO_INCREMENT bump statements...
> "%OUT%.ai" echo -- AUTO_INCREMENT bump (generated by export_local_db.bat)
for %%T in (users checkins comments reactions companion_relations notifications blocks reports badges user_badges) do (
  for /f %%N in ('"%MYSQL_BIN%\mysql.exe" -h %MYSQL_HOST% -P %MYSQL_PORT% --protocol=tcp -u root -p%MYSQL_ROOT_PASSWORD% -N -e "SELECT IFNULL(MAX(id),0)+1 FROM %DB_NAME%.%%T;" 2^>nul') do (
    >> "%OUT%.ai" echo ALTER TABLE `%%T` AUTO_INCREMENT = %%N;
  )
)
for %%T in (tree_progress user_secure) do (
  for /f %%N in ('"%MYSQL_BIN%\mysql.exe" -h %MYSQL_HOST% -P %MYSQL_PORT% --protocol=tcp -u root -p%MYSQL_ROOT_PASSWORD% -N -e "SELECT IFNULL(MAX(user_id),0)+1 FROM %DB_NAME%.%%T;" 2^>nul') do (
    >> "%OUT%.ai" echo ALTER TABLE `%%T` AUTO_INCREMENT = %%N;
  )
)
copy /y "%OUT%" + "%OUT%.ai" "%OUT%" >nul
del "%OUT%.ai"

for %%F in ("%OUT%") do echo DONE: %%~fF (%%~zF bytes)

if not "%SSH_TARGET%"=="" goto push
echo.
echo Next steps:
echo   scp "%OUT%" user@server-ip:/tmp/
echo   on server: sudo bash /opt/shinepick/import_remote.sh /tmp/shinepick-data.sql
goto done
:push
echo Pushing to %SSH_TARGET%:/tmp/ ...
scp "%OUT%" "%SSH_TARGET%":/tmp/
if errorlevel 1 (
  echo scp FAILED
  pause
  exit /b 1
)
echo Import on server: sudo bash /opt/shinepick/import_remote.sh /tmp/shinepick-data.sql
:done
pause
